{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "ClickHouse": {
    "ConnectionString": "Host=localhost;Port=8123;Database=default"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200"
  },
  "LikeSync": {
    "RetryIntervalSeconds": 5,
    "MaxRetryCount": 10
  }
}